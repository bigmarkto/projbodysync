{
  "expo": {
    "name": "BodySync",
    "slug": "bodysync",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0EA5E9"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bodysync.app",
      "versionCode": 1,
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-font"
    ]
  }
}
