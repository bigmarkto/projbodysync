# ===========================================
# BodySync API - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env real no Git!

# Porta do servidor Express
PORT=3000

# ===========================================
# BANCO DE DADOS (Supabase PostgreSQL)
# ===========================================
# Use a URL do "Transaction Pooler" (porta 6543)
# Formato: postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[SEU_PROJECT_REF]:[SUA_SENHA_DO_BANCO]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# ===========================================
# AUTENTICAÇÃO
# ===========================================
# Gere uma string longa e aleatória (ex: openssl rand -hex 32)
JWT_SECRET=uma_string_longa_e_aleatoria_aqui_mude_isso

# ===========================================
# SUPABASE (Storage de imagens)
# ===========================================
# URL pública do seu projeto Supabase
SUPABASE_URL=https://[SEU_PROJECT_REF].supabase.co

# ⚠️ IMPORTANTE: Use a chave SERVICE_ROLE (não a anon)
# Encontrada em: Settings > API > Project API keys > service_role
SUPABASE_KEY=[SUA_SERVICE_ROLE_KEY_AQUI]

# Nome do bucket no Supabase Storage
SUPABASE_BUCKET=exercise-images